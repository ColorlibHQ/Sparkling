{
  "name": "sparkling",
  "version": "2.7.1",
  "description": "Build and lint tooling for the Sparkling WordPress theme.",
  "homepage": "https://colorlib.com/wp/themes/sparkling/",
  "author": "Colorlib",
  "license": "GPL-2.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ColorlibHQ/Sparkling.git"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "lint": "npm-run-all --continue-on-error --parallel lint:js lint:css lint:php lint:phpcs",
    "lint:js": "eslint --max-warnings 0",
    "lint:css": "stylelint \"**/*.css\" --max-warnings 0",
    "lint:php": "node tools/lint-php.mjs",
    "lint:phpcs": "composer lint -- -q",
    "lint:fix": "npm-run-all lint:js:fix lint:css:fix lint:phpcs:fix",
    "lint:phpcs:fix": "composer fix -- -q",
    "lint:js:fix": "eslint --fix",
    "lint:css:fix": "stylelint \"**/*.css\" --fix",
    "i18n": "node tools/make-pot.mjs",
    "i18n:check": "node tools/check-textdomain.mjs",
    "images": "node tools/optimize-images.mjs",
    "prebuild": "npm-run-all i18n:check version:check",
    "build": "node tools/build-zip.mjs",
    "verify": "npm-run-all lint test i18n:check version:check",
    "version:check": "node tools/check-version.mjs",
    "test": "node --test tests/*.test.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "archiver": "^8.0.0",
    "eslint": "^10.8.0",
    "globals": "^17.9.0",
    "jquery": "^3.7.1",
    "jquery4": "npm:jquery@^4.0.0",
    "jsdom": "^30.1.2",
    "npm-run-all2": "^9.0.3",
    "sharp": "^0.35.3",
    "stylelint": "^17.14.1",
    "stylelint-config-standard": "^40.0.0"
  }
}
