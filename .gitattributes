# Files that exist for the repository, not for the shipped theme. Without these,
# GitHub's "Download ZIP" (which is git archive) hands users the repo scaffolding.
/.gitattributes  export-ignore
/.gitignore      export-ignore
/.jscsrc         export-ignore
/.jshintrc       export-ignore
/.jshintignore   export-ignore
/.standard.json  export-ignore
/.travis.yml     export-ignore
/.github/        export-ignore
/CLAUDE.md       export-ignore
/README.md       export-ignore
/Gruntfile.js    export-ignore
*.map            export-ignore
/package.json       export-ignore
/phpcs.ruleset.xml  export-ignore
/set_tags.sh        export-ignore
