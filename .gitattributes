# Files that exist for the repository, not for the shipped theme. Without these,
# GitHub's "Download ZIP" (which is git archive) hands users the repo scaffolding.
# npm run build is deny-by-default too (tools/build-zip.mjs).
/.gitattributes      export-ignore
/.gitignore          export-ignore
/.github/            export-ignore
/.stylelintrc.json   export-ignore
/CLAUDE.md           export-ignore
/readme.md           export-ignore
/eslint.config.mjs   export-ignore
/tools/              export-ignore
/package.json        export-ignore
/package-lock.json   export-ignore
/phpcs.xml.dist      export-ignore
/composer.json       export-ignore
/composer.lock       export-ignore
/set_tags.sh         export-ignore
*.map                export-ignore
